# Private backend configuration. The server reads process environment, not this file automatically.
# Provision and migrate with a separate owner connection; see docs/database-development.md.
APP_ENV=production
FRONTEND_PUBLIC_URL=https://reconcile.example.com
RECONCILE_ALLOWED_ORIGINS=https://reconcile.example.com
DATABASE_URL=
IDENTITY_DATABASE_URL=

# Generate privately: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_CSRF_SECRET=
AUTH_REQUIRE_VERIFICATION=true
AUTH_REGISTRATION_ENABLED=true
AUTH_DOCS_ENABLED=false
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=43200
AUTH_VERIFICATION_SECONDS=86400
AUTH_RESET_SECONDS=1800
AUTH_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_MAIL_ATTEMPTS=3
AUTH_MAIL_WINDOW_SECONDS=3600

AUTH_MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=

# Explicit local-only alternative: APP_ENV=development, both browser origins
# http://127.0.0.1:3000, AUTH_REQUIRE_VERIFICATION=false, AUTH_MAIL_MODE=disabled.
# This disables mail delivery, not sessions, CSRF, authorization, or database checks.

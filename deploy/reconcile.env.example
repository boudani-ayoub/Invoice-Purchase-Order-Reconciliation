# Install as /etc/reconcile/reconcile.env with owner root, group reconcile, and mode 0640.
APP_ENV=production
FRONTEND_PUBLIC_URL=https://reconcile.example.com
RECONCILE_ALLOWED_ORIGINS=https://reconcile.example.com

# Use separate restricted logins. Supply passwords through a protected libpq passfile or
# deployment secret mechanism; the migration-owner URL must never appear in this file.
DATABASE_URL=postgresql+psycopg://reconcile_runtime_login@db.internal/reconcile?sslmode=verify-full&sslrootcert=/etc/reconcile/database-ca.pem&passfile=/etc/reconcile/pgpass
IDENTITY_DATABASE_URL=postgresql+psycopg://reconcile_identity_login@db.internal/reconcile?sslmode=verify-full&sslrootcert=/etc/reconcile/database-ca.pem&passfile=/etc/reconcile/pgpass
DB_CONNECT_TIMEOUT_SECONDS=5
READINESS_TIMEOUT_SECONDS=2

# Generate privately. Do not reuse this example as a value.
AUTH_CSRF_SECRET=
AUTH_REQUIRE_VERIFICATION=true
AUTH_REGISTRATION_ENABLED=true
AUTH_DOCS_ENABLED=false
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=43200
AUTH_VERIFICATION_SECONDS=86400
AUTH_RESET_SECONDS=1800
AUTH_INVITATION_SECONDS=604800
AUTH_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_MAIL_ATTEMPTS=3
AUTH_MAIL_WINDOW_SECONDS=3600

AUTH_MAIL_MODE=smtp
SMTP_HOST=mail.internal.example
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_SENDER=accounts@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

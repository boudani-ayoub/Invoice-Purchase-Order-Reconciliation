# Render with scripts/render_nginx_config.py. This file belongs inside Nginx's http context.
server_tokens off;

log_format reconcile_safe escape=json
    '{"time":"$time_iso8601","request_id":"$sent_http_x_request_id",'
    '"method":"$request_method","status":$status,"bytes":$body_bytes_sent,'
    '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';
access_log off;

limit_req_zone $binary_remote_addr zone=reconcile_auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=reconcile_upload:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=reconcile_per_ip:10m;

upstream reconcile_api {
    server 127.0.0.1:{{API_PORT}};
    keepalive 16;
}

upstream reconcile_web {
    server 127.0.0.1:{{WEB_PORT}};
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name _;
    access_log off;
    error_log {{ERROR_LOG}} crit;
    return 444;
}

server {
    listen 80;
    server_name {{PUBLIC_HOST}};

    access_log {{ACCESS_LOG}} reconcile_safe;
    error_log {{ERROR_LOG}} crit;
    return 308 https://{{PUBLIC_HOST}}$request_uri;
}

server {
    listen 443 ssl default_server;
    access_log off;
    error_log {{ERROR_LOG}} crit;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    server_name {{PUBLIC_HOST}};

    access_log {{ACCESS_LOG}} reconcile_safe;
    error_log {{ERROR_LOG}} crit;

    ssl_certificate {{TLS_CERTIFICATE}};
    ssl_certificate_key {{TLS_PRIVATE_KEY}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:reconcile_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Stage HSTS only after the real hostname and HTTPS recovery path are proven.
    # Start without includeSubDomains/preload and increase max-age under change control.
    # add_header Strict-Transport-Security "max-age=300" always;

    client_body_temp_path {{CLIENT_BODY_TEMP}} 1 2;
    client_body_timeout 15s;
    keepalive_timeout 15s;
    send_timeout 30s;
    limit_conn reconcile_per_ip 20;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_hide_header Server;

    location = /health {
        client_max_body_size 1k;
        proxy_connect_timeout 3s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
        proxy_pass http://reconcile_api;
    }

    location = /health/ready {
        client_max_body_size 1k;
        proxy_connect_timeout 3s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
        proxy_pass http://reconcile_api;
    }

    location ~ ^/api/v1/auth/(?:login|register|forgot-password|resend-verification|verify-email|reset-password|invitations/preview|invitations/accept|register-invited)$ {
        client_max_body_size 32k;
        limit_req zone=reconcile_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_connect_timeout 3s;
        proxy_send_timeout 20s;
        proxy_read_timeout 20s;
        proxy_pass http://reconcile_api;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }

    location ~ ^/api/v1/(?:reconcile|analyses/|runs/(?:invoice-po|invoice-receipt|po-receipt|three-way)) {
        client_max_body_size 32m;
        limit_conn reconcile_per_ip 4;
        limit_req zone=reconcile_upload burst=3 nodelay;
        limit_req_status 429;
        proxy_connect_timeout 3s;
        proxy_send_timeout 130s;
        proxy_read_timeout 130s;
        proxy_pass http://reconcile_api;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }

    location /api/ {
        client_max_body_size 256k;
        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_pass http://reconcile_api;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }

    location / {
        client_max_body_size 32k;
        proxy_connect_timeout 3s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://reconcile_web;
    }
}
